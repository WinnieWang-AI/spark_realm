    "scene_001": {
      "id": "scene_001",
      "title": "鲁贵的盘算",
      "summary": "鲁贵醉醺醺地向四凤要钱，暗示自己知道她与周萍的私情，以此要挟。",
      "locationId": "loc_zhou_hall",
      "time": { "timeOfDay": "afternoon" },
      "threadIds": ["thread_main"],
      "narrativeMode": "present",
      "narrativeRole": "setup",
      "mood": "阴郁压抑",
      "participants": {
        "char_lugui": { "emotion": "贪吝得意", "goal": "从四凤身上榨钱", "knowledge": "知道四凤与周萍的私情" },
        "char_sifeng": { "emotion": "羞愤不安", "goal": "摆脱父亲的纠缠" }
      },
      "locationState": null,
      "props": {},
      "beats": [
        { "id": "beat_0001", "kind": "action", "text": "鲁贵醉醺醺地在客厅里数落四凤，伸手向她要钱。" },
        { "id": "beat_0002", "kind": "dialogue", "speakerId": "char_lugui", "tone": "油滑要挟", "text": "你现在阔了，跟大少爷好上了，就忘了你爹？" },
        { "id": "beat_0003", "kind": "dialogue", "speakerId": "char_sifeng", "tone": "羞愤", "text": "爹，您别胡说……" },
        { "id": "beat_0004", "kind": "action", "text": "鲁贵意味深长地提起周家见不得人的事，四凤又羞又怕，只得应下。" }
      ]
    },
    "scene_002": {
      "id": "scene_002",
      "title": "周冲的心意",
      "summary": "周冲真诚地向四凤表达爱意，说要出钱供她读书，四凤心神不宁地回避。",
      "locationId": "loc_zhou_hall",
      "time": { "timeOfDay": "afternoon" },
      "threadIds": ["thread_main"],
      "narrativeMode": "present",
      "narrativeRole": "setup",
      "mood": "天真温和",
      "participants": {
        "char_chong": { "emotion": "热忱天真", "goal": "让四凤上学，与她相好" },
        "char_sifeng": { "emotion": "局促愧疚", "knowledge": "心里只有周萍" }
      },
      "locationState": null,
      "props": {},
      "beats": [
        { "id": "beat_0005", "kind": "dialogue", "speakerId": "char_chong", "tone": "真诚", "text": "四凤，我想让父亲出钱，送你上学。" },
        { "id": "beat_0006", "kind": "dialogue", "speakerId": "char_sifeng", "tone": "慌乱", "text": "二少爷，我配不上……" },
        { "id": "beat_0007", "kind": "action", "text": "周冲一片天真，四凤却低着头，心里全是周萍的影子。" }
      ]
    },
    "scene_003": {
      "id": "scene_003",
      "title": "暗涌",
