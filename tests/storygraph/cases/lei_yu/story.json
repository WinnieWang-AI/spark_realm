      "locationState": null,
      "props": {},
      "beats": [
        { "id": "beat_0008", "kind": "dialogue", "speakerId": "char_fanyi", "tone": "幽怨", "text": "萍，你就要走了，难道我们……就这样算了？" },
        { "id": "beat_0009", "kind": "dialogue", "speakerId": "char_ping", "tone": "痛苦克制", "text": "太太，我们不能再错下去。" },
        { "id": "beat_0010", "kind": "action", "text": "繁漪盯了他许久，冷笑一声，眼底埋下怨恨。" }
      ]
