  "scenes": {
    "scene_001": {
      "id": "scene_001",
      "title": "妈妈的嘱托",
      "summary": "小红帽在村庄家中收到妈妈准备的篮子，被叮嘱走大路、不要和陌生人说话。",
      "locationId": "loc_village",
      "time": { "timeOfDay": "morning" },
      "threadIds": ["thread_main"],
      "narrativeMode": "present",
      "narrativeRole": "setup",
      "mood": "温馨明快",
      "participants": {
        "char_red": { "emotion": "开心期待", "goal": "出发去外婆家", "appearance": null },
        "char_mother": { "emotion": "温柔叮嘱", "goal": "叮嘱女儿注意安全", "appearance": null }
      },
      "locationState": null,
      "props": {
        "prop_basket": { "holderId": "char_red" }
      },
      "beats": [
        { "id": "beat_0001", "kind": "action", "text": "小红帽站在家门口，阳光照在她的红色斗篷上。妈妈从屋内走出，递给她一个藤编篮子。" },
        { "id": "beat_0002", "kind": "dialogue", "speakerId": "char_red", "tone": "好奇，兴奋", "text": "妈妈，篮子里装了什么呀？好香！" },
        { "id": "beat_0003", "kind": "action", "text": "妈妈蹲下来，帮小红帽整理斗篷，轻轻拍了拍她的脸颊。" },
        { "id": "beat_0004", "kind": "narration", "text": "妈妈叮嘱小红帽：走大路，不要在林子里逗留，不要和陌生人说话。" },
        { "id": "beat_0005", "kind": "action", "text": "小红帽用力点头，提起篮子，蹦蹦跳跳地沿着石板路向村口走去。" }
      ]
    },
    "scene_002": {
      "id": "scene_002",
      "title": "林间漫步",
      "summary": "小红帽走在阳光明媚的森林小路上，欣赏花草蝴蝶，心情愉悦。",
      "locationId": "loc_forest_path",
      "time": { "timeOfDay": "morning" },
      "threadIds": ["thread_main"],
      "narrativeMode": "present",
      "narrativeRole": "setup",
      "mood": "轻快愉悦",
      "participants": {
        "char_red": { "emotion": "快乐天真", "appearance": null }
      },
      "locationState": null,
      "props": {
        "prop_basket": { "holderId": "char_red" }
      },
      "beats": [
        { "id": "beat_0006", "kind": "action", "text": "小红帽走在铺满落叶的林间小路上，红色斗篷在树影间闪动。她一手提着篮子，一手拨开路旁的灌木。" },
        { "id": "beat_0007", "kind": "action", "text": "一只蓝色蝴蝶飞到小红帽鼻尖，她咯咯笑着伸手去追，在花丛间转了个圈。" },
        { "id": "beat_0008", "kind": "dialogue", "speakerId": "char_red", "tone": "自言自语，开心", "text": "外婆一定会喜欢这些花的！" },
        { "id": "beat_0009", "kind": "action", "text": "小红帽弯腰摘了几朵野花，小心翼翼地放进篮子。远处树丛中，一双黄色的眼睛正注视着她。" }
      ]
    },
    "scene_003": {
      "id": "scene_003",
      "title": "狼的出现",
      "summary": "大灰狼在森林深处拦住小红帽，假装友善套话，得知她要去外婆家。",
      "locationId": "loc_forest_deep",
      "time": { "timeOfDay": "midday" },
      "threadIds": ["thread_main"],
      "narrativeMode": "present",
      "narrativeRole": "turningPoint",
      "mood": "表面友善，暗藏危险",
      "participants": {
        "char_red": { "emotion": "从好奇到轻信", "knowledge": "以为对方像一只大狗", "appearance": null },
        "char_wolf": { "emotion": "伪善友好，内心贪婪", "goal": "问出外婆家的地址", "appearance": null }
      },
      "locationState": {
        "lighting": "阳光被遮挡，只有零星光斑穿透树冠",
        "condition": "树木高大密集，地面长满苔藓"
      },
      "props": {
        "prop_basket": { "holderId": "char_red" }
      },
      "beats": [
        { "id": "beat_0010", "kind": "action", "text": "小红帽走进森林深处，周围突然安静下来。一个高大的身影从橡树后缓缓走出——是一只灰褐色的大灰狼。" },
        { "id": "beat_0011", "kind": "dialogue", "speakerId": "char_wolf", "tone": "温和友善，略带虚伪", "text": "你好啊小姑娘，你要去哪里呀？" },
        { "id": "beat_0012", "kind": "action", "text": "小红帽没有害怕。她不认识大灰狼，觉得他看起来就像一只大狗。" },
        { "id": "beat_0013", "kind": "dialogue", "speakerId": "char_red", "tone": "天真坦诚", "text": "我去外婆家，给她送蛋糕和葡萄酒。她生病了，住在森林那头的小木屋里。" },
        { "id": "beat_0014", "kind": "action", "text": "大灰狼的耳朵微微竖起，尾巴不自觉地摇了一下。他的脑海中已经在盘算。" },
        { "id": "beat_0015", "kind": "dialogue", "speakerId": "char_wolf", "tone": "诱导，暗藏算计", "text": "这片林子里有好多漂亮的花，你为什么不摘一些带给外婆呢？" },
        { "id": "beat_0016", "kind": "action", "text": "小红帽看向路边的花丛，眼睛亮了起来。当她转身去摘花时，大灰狼已经悄无声息地消失在树丛中。" }
      ]
    },
    "scene_004": {
      "id": "scene_004",
      "title": "狼的诡计",
      "summary": "大灰狼抄近路飞奔到外婆家，敲门骗过外婆，将外婆吞入腹中。",
      "locationId": "loc_grandma_house",
      "areaId": "area_doorway",
      "time": { "timeOfDay": "midday" },
      "threadIds": ["thread_main"],
      "narrativeMode": "present",
      "narrativeRole": "turningPoint",
      "mood": "紧张凶险",
      "participants": {
        "char_wolf": { "emotion": "凶狠急切", "appearance": null },
        "char_grandma": { "emotion": "虚弱，被惊吓", "appearance": null }
      },
      "locationState": null,
      "props": {},
      "beats": [
        { "id": "beat_0017", "kind": "action", "text": "大灰狼气喘吁吁地跑到外婆家门前。他整理了一下毛皮，压低嗓音。" },
        { "id": "beat_0018", "kind": "dialogue", "speakerId": "char_wolf", "tone": "模仿小女孩的声音", "text": "外婆，是我，小红帽。给您送蛋糕来了。" },
        { "id": "beat_0019", "kind": "dialogue", "speakerId": "char_grandma", "tone": "虚弱，慈祥", "text": "拉一下门栓就开了，孩子。外婆今天没力气起床。" },
        { "id": "beat_0020", "kind": "action", "text": "大灰狼推开门，露出森森白牙。外婆惊恐地睁大眼睛，但来不及呼救。" }
      ]
    },
    "scene_005": {
      "id": "scene_005",
      "title": "伪装",
      "summary": "大灰狼穿上外婆的睡衣，戴上睡帽，躺在床上等待小红帽。",
      "locationId": "loc_grandma_house",
      "areaId": "area_bedroom",
      "time": { "timeOfDay": "afternoon" },
      "threadIds": ["thread_main"],
      "narrativeMode": "present",
      "narrativeRole": "transition",
      "mood": "诡异不安",
      "participants": {
        "char_wolf": {
          "emotion": "得意狡猾",
          "appearance": "穿着外婆的白色睡衣，戴着花边睡帽，把自己裹在被子里"
        }
      },
      "locationState": {
        "lighting": "壁炉火光映着墙上的阴影，光线昏暗",
        "condition": "被褥凌乱，地上有挣扎的痕迹"
      },
      "props": {},
      "beats": [
        { "id": "beat_0021", "kind": "action", "text": "大灰狼笨拙地穿上外婆的白色睡衣，把花边睡帽扣在头上，尖耳朵从帽边露出来。" },
        { "id": "beat_0022", "kind": "action", "text": "他爬上床，把被子拉到下巴，只露出戴着睡帽的脑袋。壁炉的暖光让这一切看起来几乎天衣无缝。" },
        { "id": "beat_0023", "kind": "action", "text": "远处传来轻快的脚步声和小女孩的哼唱。大灰狼咧嘴笑了。" }
      ]
    },
    "scene_006": {
      "id": "scene_006",
      "title": "经典问答",
      "summary": "小红帽到达外婆家，对大灰狼的眼睛、耳朵、嘴巴产生疑问，大灰狼露出真面目。",
      "locationId": "loc_grandma_house",
      "areaId": "area_bedroom",
      "time": { "timeOfDay": "afternoon" },
      "threadIds": ["thread_main"],
      "narrativeMode": "present",
      "narrativeRole": "climax",
      "mood": "悬疑紧张，从疑惑升级到恐惧",
      "participants": {
        "char_red": { "emotion": "从疑惑到恐惧", "appearance": null },
        "char_wolf": {
          "emotion": "从伪装到暴露",
          "appearance": "从伪装的外婆恢复原形，掀开被子露出灰褐色毛皮和尖齿"
        }
      },
      "locationState": null,
      "props": {
        "prop_basket": { "appearance": "被放在桌上，格子布掀开一角", "holderId": null }
      },
      "beats": [
        { "id": "beat_0024", "kind": "action", "text": "小红帽推门进来，把篮子放在桌上。她走向床边，觉得外婆今天看起来有些不同。" },
        { "id": "beat_0025", "kind": "dialogue", "speakerId": "char_red", "tone": "疑惑", "text": "外婆，你的耳朵怎么这么大呀？" },
        { "id": "beat_0026", "kind": "dialogue", "speakerId": "char_wolf", "tone": "压低声音模仿外婆", "text": "为了更好地听你说话呀，孩子。" },
        { "id": "beat_0027", "kind": "dialogue", "speakerId": "char_red", "tone": "越来越不安", "text": "外婆，你的眼睛怎么这么大呀？" },
        { "id": "beat_0028", "kind": "dialogue", "speakerId": "char_wolf", "tone": "声音渐渐变粗", "text": "为了更好地看清你呀，孩子。" },
        { "id": "beat_0029", "kind": "dialogue", "speakerId": "char_red", "tone": "恐惧颤抖", "text": "外婆，你的嘴巴怎么这么大呀？" },
        { "id": "beat_0030", "kind": "dialogue", "speakerId": "char_wolf", "tone": "凶狠，暴露真面目", "text": "为了——吃掉你！" },
        { "id": "beat_0031", "kind": "action", "text": "大灰狼猛地掀开被子，扑向小红帽。小红帽发出一声尖叫。" }
      ]
    },
