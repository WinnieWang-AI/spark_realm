      "beats": [
        { "id": "beat_0032", "kind": "action", "text": "猎人巡林路过外婆的小屋，听到里面传来震天的鼾声。他皱起眉头——老太太不会打这么响的呼噜。" },
        { "id": "beat_0033", "kind": "dialogue", "speakerId": "char_hunter", "tone": "低声自语，警觉", "text": "不对劲……" },
        { "id": "beat_0034", "kind": "action", "text": "猎人轻轻推开门，看到床上躺着一只肚子鼓胀的大灰狼，穿着外婆的睡衣，正打着呼噜。" },
        { "id": "beat_0035", "kind": "action", "text": "猎人迅速从背后取下猎斧，一步步靠近床边。他注意到大灰狼鼓起的肚子还在动。" }
      ]
    },
