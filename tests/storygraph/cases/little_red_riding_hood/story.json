      "beats": [
        { "id": "beat_0036", "kind": "action", "text": "猎人小心地用猎斧割开大灰狼的肚子。小红帽先跳了出来，然后外婆也被救了出来。" },
        { "id": "beat_0037", "kind": "dialogue", "speakerId": "char_red", "tone": "哭着扑过去", "text": "外婆！" },
